# 실제 값은 이 파일이 아니라 Vercel 프로젝트의
# Settings → Environment Variables 화면에 직접 입력하세요.
# 이 파일은 어떤 이름의 환경변수가 필요한지 보여주는 예시일 뿐이며,
# 값이 비어 있으므로 커밋해도 안전합니다.

ADMIN_USER=
ADMIN_PASSWORD=

# Upstash Redis 관련 값은 Vercel Storage 탭에서 Upstash를 연결하면
# 자동으로 채워지므로, 직접 입력하실 필요는 없습니다 (안내용으로만 남겨둡니다).
KV_REST_API_URL=
KV_REST_API_TOKEN=
